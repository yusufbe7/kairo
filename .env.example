# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# .env.local is gitignored — never commit real secrets.

# ─── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (required) ──────────────────────────────────────────────
# Supabase dashboard → Project Settings → API
# The service role key bypasses RLS: server only, never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Encryption (required before connecting any social account) ───────
# 32 random bytes, base64:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ─── AI Studio (optional — AI features are hidden in the UI when unset) ───
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# ─── Background jobs (optional in dev, required in production) ────────
# Without Redis the rate limiter falls back to in-process memory and the
# worker polls the scheduled_jobs table instead of consuming a queue.
REDIS_URL=

# ─── Uploads & logging ────────────────────────────────────────────────
MEDIA_MAX_BYTES=209715200
LOG_PERSIST_LEVEL=warn

# ─── Social providers ─────────────────────────────────────────────────
# Each provider stays inert until BOTH its credentials are set AND its
# integration module exists (see lib/integrations/README.md).
# /admin/integrations shows a ✓/✗ checklist for every variable below.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

TELEGRAM_BOT_TOKEN=
