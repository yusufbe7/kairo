# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# .env.local is gitignored — never commit real secrets.

# ─── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (required) ──────────────────────────────────────────────
# Supabase dashboard → Project Settings → API
# The service role key bypasses RLS: server only, never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Encryption (required before connecting any social account) ───────
# 32 random bytes, base64:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ─── Google sign-in (required — it is the only way in) ────────────────
# Enable the Google provider in Supabase → Authentication → Providers, and turn
# the Email provider OFF there, or accounts can still be created through the API
# with a password that nothing in the product expects.
# Left unset, the button is hidden rather than broken.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

# ─── Stripe billing (required — Kairo is paid-only) ───────────────────
# Kairo grants access only while Stripe reports a trialing or active
# subscription. Without these, /billing says so and the dashboard stays locked.
STRIPE_SECRET_KEY=
# Stripe CLI (`stripe listen --forward-to localhost:3000/api/webhooks/stripe`)
# prints this in development; in production it comes from the webhook endpoint.
STRIPE_WEBHOOK_SECRET=

# One Stripe Price id per plan and interval. A plan with no price is not offered.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# ─── AI Studio (optional — AI features are hidden in the UI when unset) ───
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# ─── Scheduled publishing (required in production) ────────────────────
# Kairo has no worker process: a scheduler calls /api/cron/publish once a
# minute and that drains the queue. This secret is how the route knows the
# caller is your scheduler — without it the route returns 503 and nothing
# scheduled ever publishes.
#   openssl rand -hex 32
# Then run supabase/schedule-publishing.sql once in the Supabase SQL editor.
CRON_SECRET=

# ─── Background jobs (optional everywhere) ────────────────────────────
# Redis only decides when a runner wakes up; scheduled_jobs is always the
# source of truth. Without it the rate limiter also falls back to
# in-process memory.
REDIS_URL=

# ─── Uploads & logging ────────────────────────────────────────────────
MEDIA_MAX_BYTES=209715200
LOG_PERSIST_LEVEL=warn

# ─── Social providers ─────────────────────────────────────────────────
# Each provider stays inert until BOTH its credentials are set AND its
# integration module exists (see lib/integrations/README.md).
# /admin/integrations shows a ✓/✗ checklist for every variable below.
# Both use the SAME Facebook App ID and secret, from App settings → Basic — not the
# separate "Instagram App ID" shown on the Instagram product page.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Only for apps using "Facebook Login for Business", where permissions live in a
# configuration instead of the scope parameter. Leave blank for plain Facebook Login.
#
# One configuration can serve both providers if it carries every permission either
# flow needs — set META_LOGIN_CONFIG_ID alone for that. The per-platform variables
# override it, and keeping them separate means a Facebook-only connection isn't asked
# for Instagram permissions.
META_LOGIN_CONFIG_ID=
FACEBOOK_LOGIN_CONFIG_ID=
INSTAGRAM_LOGIN_CONFIG_ID=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

TELEGRAM_BOT_TOKEN=
